{
  "name": "pruvlandingpage",
  "private": true,
  "version": "1.0.0",
  "description": "PRUV landing page (static). Tailwind is precompiled to tailwind.css; run `npm run build` after editing index.html.",
  "scripts": {
    "build": "tailwindcss -i src/input.css -o tailwind.css --minify",
    "watch": "tailwindcss -i src/input.css -o tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  }
}
